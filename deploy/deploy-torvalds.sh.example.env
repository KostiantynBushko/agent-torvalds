# Agent Torvalds Environment Configuration
# Copy this file to .env and adjust values as needed.
#
# The variable names are the ones the agent reads.  The deployment
# script writes a .env of its own, with the same names.

# ---------------------------------------------------------------------------
# Ollama Configuration
# ---------------------------------------------------------------------------
TORVALDS_OLLAMA_HOST=http://localhost:11434
TORVALDS_MODEL=richardyoung/qwen3.6-27b-abliterated:Q4_K_M
TORVALDS_EMBEDDING_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# PostgreSQL Configuration
# ---------------------------------------------------------------------------
TORVALDS_PG_HOST=127.0.0.1
TORVALDS_PG_PORT=5432
TORVALDS_PG_USER=llama
TORVALDS_PG_PASSWORD=llama
TORVALDS_PG_DATABASE=llama_index_db

# ---------------------------------------------------------------------------
# Application Configuration
# ---------------------------------------------------------------------------
# TORVALDS_DEPLOY_DIR is set automatically by the deployment script
